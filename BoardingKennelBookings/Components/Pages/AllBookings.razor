@page "/AllBookings"

@using BoardingKennelBookings.Components.Services
@using BoardingKennelBookings.Components.Helpers
@using BoardingKennelBookings.Components.Models
@using BoardingKennelBookings.Components.Shared

@rendermode InteractiveServer
@inject DogService DogService
@inject KennelAvailabilityService KennelAvailabilityService
@inject KennelService KennelService
@inject BookingService BookingService
@inject OwnerService OwnerService

@code {
    private DateTime startDate = DateTime.Today.AddDays(-30);
    private DateTime endDate = DateTime.Today.AddDays(1);
    private List<Kennel> allKennels = new List<Kennel>();
    private List<BookingDogKennel> bookingDogKennels = new List<BookingDogKennel>();
    private List<Booking> bookings = new List<Booking>();
    private List<Dog> currentDogs = new List<Dog>();
    private List<Owner> allOwners = new List<Owner>();
    private bool dataLoaded = false;
    private string dateError = "";
    private bool callPopup = false;
    private Booking selectedBooking = new();
    private Owner selectedOwner = new();

    private List<Kennel> bookingKennels = new();
    private List<Dog> bookingDogs = new();
    private List<BookingDogKennel> bookingBDKs = new();

    

    protected override async Task OnInitializedAsync()
    {
        allKennels = await KennelService.GetAllKennels();
        allOwners = await OwnerService.GetAllOwnersAsync();

        await HandleCheckBookings();

        dataLoaded = true;
    }

    private void HandleDateChosen()
    {
        if (!DateHelper.IsValidDateRange(startDate, endDate)) { dateError = "End date is earlier than Start date"; }
    }

    private async Task HandleCheckBookings()
    {
        bookings = await BookingService.FindBookingsWithInDateRange(startDate, endDate);

        foreach (var booking in bookings)
        {
            List<BookingDogKennel> bookingBdks = await BookingService.FindBookingDogKennelsWithBookingID(booking.BookingID);
            bookingDogKennels.AddRange(bookingBdks);
        }

        foreach (var bdk in bookingDogKennels)
        {
            if (await DogService.GetDog(bdk.DogID) != null)
            {
                currentDogs.Add(await DogService.GetDog(bdk.DogID));
            }
        }
    }

    private void HandleBookingEdit(Booking booking)
    {
        selectedBooking = booking;
        callPopup = true;
        bookingDogs = currentDogs.Where(dog => dog.OwnerID == selectedBooking.OwnerID).ToList();
        bookingBDKs = bookingDogKennels.Where(bdk => bdk.BookingID == selectedBooking.BookingID).ToList();
        selectedOwner = allOwners.FirstOrDefault(owner => owner.OwnerID == booking.OwnerID);
       
        foreach (var bdk in bookingBDKs)
        {
            bookingKennels.Add(allKennels.FirstOrDefault(curKennel => curKennel.KennelID == bdk.KennelID));
        }
    }
}

<h3>All Bookings</h3>

@if (dataLoaded)
{
    <div class="row wd-100">
    
        <section>
            <label>
                Start date
            </label>
            <InputDate @bind-Value="startDate" @bind-Value:after="HandleDateChosen" />
        </section>

        <section>
            <label>
                End date
            </label>
            <InputDate @bind-Value="endDate" @bind-Value:after="HandleDateChosen" />
        </section>
        <section>

            <button type="button" class="btn btn-blue" @onclick="HandleCheckBookings">Check</button>
        </section>
    </div>

    <div class="row wd-100">
        <ul>
            @foreach (var booking in bookings)
            {
                Owner curOwner = allOwners.FirstOrDefault(owner => owner.OwnerID == booking.OwnerID);
                List<BookingDogKennel> bookingBDKs = bookingDogKennels.FindAll(bdk => bdk.BookingID == booking.BookingID);
                List<Dog> curDogs = new();
                int dogCount = 0;

                @foreach(var curBDK in bookingBDKs)
                {
                    curDogs.Add(currentDogs.FirstOrDefault(dog => dog.ID == curBDK.DogID));
                }

                <li>
                    @curOwner.FirstName @curOwner.LastName booked their dog @foreach(var dog in curDogs)
                    {
                        @dog.DogName
                        dogCount++;
                        if (curDogs.Count > dogCount)
                        {
                            <span>, </span>
                        }
                        else
                        {
                            <span> </span>
                        }
                    }
                    in for 
                    @booking.StartDate.ToShortDateString() --> @booking.EndDate.ToShortDateString()

                    <button class="button" @onclick="() => HandleBookingEdit(booking)"> Edit </button>
                </li>
            }
        </ul>
    </div>

<div class="booking-history">

    <div class="booking-history-header">
        <div>
            <h3>Bookings</h3>
            <p>View and manage kennel bookings by date.</p>
        </div>
    </div>

    <div class="booking-history-filters">
        <section class="booking-history-field">
            <label for="booking-start-date">Start date</label>
            <InputDate id="booking-start-date"
                       @bind-Value="startDate"
                       @bind-Value:after="HandleDateChosen"
                       class="booking-history-input" />
        </section>

        <section class="booking-history-field">
            <label for="booking-end-date">End date</label>
            <InputDate id="booking-end-date"
                       @bind-Value="endDate"
                       @bind-Value:after="HandleDateChosen"
                       class="booking-history-input" />
        </section>

        <button type="button"
                class="booking-history-check"
                @onclick="HandleCheckBookings">
            Check bookings
        </button>
    </div>
 
            <div class="previous-bookings">
                <div class="previous-bookings-list">
                    @if (bookings.Count > 0)
                    {
                        @foreach (var booking in bookings)
                        {
                            var curOwner = allOwners.FirstOrDefault(owner => owner.OwnerID == booking.OwnerID);

                            var bookingBDKs = bookingDogKennels.FindAll(bdk => bdk.BookingID == booking.BookingID);

                            var curDogs = bookingBDKs.Select(bdk => currentDogs.FirstOrDefault(dog => dog.ID == bdk.DogID)).Where(dog => dog != null).ToList();

                            <article class="previous-bookings-card" @key="booking.BookingID">
                                <div class="booking-history-details">
                                <div class="previous-bookings-owner">
                                        @if (curOwner != null)
                                        {
                                            <h4>@curOwner.FirstName @curOwner.LastName</h4>
                                        }
                                        else
                                        {
                                            <h4>Unknown owner</h4>
                                        }

                              
                                    </div>
                                    <span class="previous-bookings-count">
                                        @curDogs.Count @(curDogs.Count == 1 ? "dog" : "dogs")
                                    </span>
                                    <div class="previous-bookings-dogs">
                                        @foreach (var dog in curDogs)
                                        {
                                        <span class="previous-bookings-dog" @key="dog.ID">
                                                @dog.DogName
                                            </span>
                                        }
                                    </div>

                                   
                                </div>
                            <div class="previous-bookings-dates">
                                <div class="previous-bookings-date">
                                    <span class="previous-bookings-label">Check-in</span>
                                    <span>@booking.StartDate.ToString("dd MMM yyyy")</span>
                                </div>

                                <span class="previous-bookings-arrow">→</span>

                                <div class="previous-bookings-date">
                                    <span class="previous-bookings-label">Check-out</span>
                                    <span>@booking.EndDate.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                            <button type="button" class="previous-bookings-edit" @onclick="() => HandleBookingEdit(booking)">
                                    Edit
                                </button>
                            </article>
                        }
                    }
                    else
                    {
                        <div class="booking-history-empty">
                            <p>No bookings found for the selected dates.</p>
                        </div>
                    }
                </div>
            </div>
 
  
</div>

    @if (callPopup)
    {
        <popup>
            <BookingFormComponent isEditingBooking="true" Owners="new List<Owner> { selectedOwner }" editedBooking="selectedBooking" @key="selectedBooking" />
        </popup>
    }
}