<div class="booking-history">

    <div class="booking-history-header">
        <div>
            <p>View and manage kennel bookings by date.</p>
        </div>
    </div>

    <div class="booking-history-filters is-compact">
        <section class="booking-history-field">
            <label for="booking-start-date">Start date</label>
            <InputDate id="booking-start-date"
                       @bind-Value="startDate"
                       @bind-Value:after="HandleDateChosen"
                       class="booking-history-input" />
        </section>

        <section class="booking-history-field">
            <label for="booking-end-date">End date</label>
            <InputDate id="booking-end-date"
                       @bind-Value="endDate"
                       @bind-Value:after="HandleDateChosen"
                       class="booking-history-input" />
        </section>

        <button type="button"
                class="booking-history-check"
                disabled="@(dateError != null)"
                @onclick="HandleCheckBookings">
            Check bookings
        </button>

        @if (dateError != null)
        {
            <div class="booking-history-error" role="alert">
                @dateError
            </div>
        }
    </div>
 
    <div class="bk-table-wrap">
        @if (bookings.Count > 0)
        {
            <table class="bk-table">
                <thead>
                    <tr>
                        <th>Kennel</th>
                        <th>Dog</th>
                        <th>Owner</th>
                        <th>Check-in</th>
                        <th>Check-out</th>
                        <th>Drop-off</th>
                        <th>Pick-up</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in bookings)
                    {
                        var curOwner = allOwners.FirstOrDefault(owner => owner.OwnerID == booking.OwnerID);

                        var bookingBDKs = bookingDogKennels.FindAll(bdk => bdk.BookingID == booking.BookingID);

                        @foreach (var bdk in bookingBDKs)
                        {
                            var curDog = currentDogs.FirstOrDefault(dog => dog.ID == bdk.DogID);
                            var curKennel = allKennels.FirstOrDefault(kennel => kennel.KennelID == bdk.KennelID);

                            <tr @key="bdk.BookingDogKennelID">
                                <td class="bk-cell-kennel">@(curKennel != null ? $"K{curKennel.KennelNumber:00}" : "—")</td>
                                <td class="bk-cell-dog">@(curDog?.DogName ?? "Unknown dog")</td>
                                <td class="bk-cell-owner">@(curOwner != null ? $"{curOwner.FirstName} {curOwner.LastName}" : "Unknown owner")</td>
                                <td class="bk-cell-date">@booking.StartDate.ToString("dd/MM/yyyy")</td>
                                <td class="bk-cell-date">@booking.EndDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="bk-badge">@(booking.AMDropoff ? "AM" : "PM")</span></td>
                                <td><span class="bk-badge">@(booking.AMPickup ? "AM" : "PM")</span></td>
                                <td class="bk-cell-actions">
                                    <button type="button" class="bk-edit" @onclick="() => HandleBookingEdit(booking)">Edit</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="bk-table-empty">
                <p>No bookings found for the selected dates.</p>
            </div>
        }
    </div>

    <div class="bk-table-toolbar">
        <span class="bk-table-count">@bookingDogKennels.Count @(bookingDogKennels.Count == 1 ? "record" : "records")</span>
    </div>

</div>

    @if (callPopup)
    {
        <popup>
            <BookingFormComponent isEditingBooking="true" Owners="new List<Owner> { selectedOwner }" editedBooking="selectedBooking" @key="selectedBooking" />
        </popup>
    }
}