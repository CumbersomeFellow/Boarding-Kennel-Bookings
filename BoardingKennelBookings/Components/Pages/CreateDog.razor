@page "/createdog"

@using BoardingKennelBookings.Components.Services
@using BoardingKennelBookings.Components.Models

@rendermode InteractiveServer
@inject OwnerService OwnerService
@inject DogService DogService

<EditForm Model="newDog" OnValidSubmit="HandleSubmit" FormName="CreateDogForm">
    <div class="booking-form">

        <div class="booking-form-header">
            <p>Enter the dog's details below.</p>
        </div>

        <div class="booking-form-fields">
            <div class="booking-form-field">
                <label for="dogName">Name</label>
                <InputText id="dogName" class="booking-form-input" @bind-Value="newDog.DogName" />
            </div>

            <div class="booking-form-field">
                <label for="dogBreed">Breed</label>
                <InputText id="dogBreed" class="booking-form-input" @bind-Value="newDog.Breed" />
            </div>
        </div>

        <div class="booking-form-fields">
            <div class="booking-form-field">
                <label for="dogOwner">Owner</label>
                @if (Owners.Count == 0)
                {
                    <p>Loading Owners...</p>
                }
                else
                {
                    <InputSelect id="dogOwner" class="booking-form-input" @bind-Value="selectedOwnerId">
                        <option value="@Guid.Empty">--Choose an owner--</option>
                        @foreach (var owner in Owners)
                        {
                            <option value="@owner.OwnerID">@owner.FirstName @owner.LastName</option>
                        }
                    </InputSelect>
                }
            </div>
        </div>

        <div class="booking-form-actions final">
            <button type="submit" class="booking-form-button booking-form-button-primary">
                Create dog
            </button>
        </div>

    </div>
</EditForm>

@code {
    private List<Owner> Owners = new();

    protected override async Task OnInitializedAsync()
    {
        Owners = await OwnerService.GetAllOwnersAsync();
    }
}


@code {
    private Dog newDog = new();
    private Dog? createdDog;
    private Guid selectedOwnerId;
    private Owner selectedOwner = new();


    private async Task HandleSubmit()
    {
        //filter owners with id to give owner to the dog
        selectedOwner = await OwnerService.FindOwnerByID(selectedOwnerId);

        if (selectedOwner != null)
        {
            newDog.OwnerID = selectedOwner.OwnerID;   
            newDog.Owner = selectedOwner;
        }

        createdDog = await DogService.CreateDogAsync(newDog);
    }
}
@if (createdDog != null)
{
    <div class="booking-form-kennel-section">
        <div class="booking-form-kennel-header">
            <h3>Dog created</h3>
            <p>@createdDog.DogName has been added.</p>
        </div>
    </div>
}