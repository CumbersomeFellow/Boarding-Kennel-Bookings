@page "/"

@using BoardingKennelBookings.Components.Services
@using BoardingKennelBookings.Components.Helpers
@using BoardingKennelBookings.Components.Models
@using BoardingKennelBookings.Components.Shared

@rendermode InteractiveServer
@inject DogService DogService
@inject KennelAvailabilityService KennelAvailabilityService
@inject KennelService KennelService
@inject BookingService BookingService

@code {
    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today;
    private List<Kennel> allKennels = new List<Kennel>();
    private List<BookingDogKennel> bookingDogKennels = new List<BookingDogKennel>();
    private List<Booking> bookings = new List<Booking>();
    private List<Dog> currentDogs = new List<Dog>();
    private bool dataLoaded = false;
    private int occupiedKennels = 0;
    private int availableKennels = 0;
    private int needCleanKennels = 0;

    //get all kennels
    //get - need to get bookings first
    //then dog booking kennels with bookingsIDs from above
    //if kennel 
    //need to add kennel status also
    //then find all dogs in dog booking kennel to output

    protected override async Task OnInitializedAsync()
    {
        startDate = DateTime.Today;
        endDate = DateTime.Today.AddDays(1);
        allKennels = await KennelService.GetAllKennels();
        bookings = await BookingService.FindBookingsWithInDateRange(startDate, endDate);
        foreach(var booking in bookings)
        {
            List<BookingDogKennel> bookingBdks = await BookingService.FindBookingDogKennelsWithBookingID(booking.BookingID);
            bookingDogKennels.AddRange(bookingBdks);
        }

        foreach (var bdk in bookingDogKennels)
        {
            if (await DogService.GetDog(bdk.DogID) != null)
            {
                currentDogs.Add(await DogService.GetDog(bdk.DogID));
            }
        }

        foreach(var kennel in allKennels)
        {
            if(bookingDogKennels.Where(bdk => bdk.KennelID == kennel.KennelID).Count() > 0)
            {
                occupiedKennels++;
            }
            else if(kennel.Status == KennelStatus.Available)
            {
                availableKennels++;
            }else if (kennel.Status == KennelStatus.NeedsCleaning)
            {
                needCleanKennels++;
            }
        }


        dataLoaded = true;
    }

   
}

<PageTitle>Home</PageTitle>

<div class="grid grid-cols-4 gap-3">

    <div class="rounded-xl px-5 py-4 flex flex-col gap-2 relative overflow-hidden">
        <div class="stat-card">
            <div class="bg pad-2 wd-100">
                <h4>
                    Total Kennels
                </h4>
                <p>
                    @allKennels.Count
                </p>
                <label>
                    kennels in facility
                </label>
            </div>
        </div>
    </div>
    <div class="rounded-xl px-5 py-4 flex flex-col gap-2 relative overflow-hidden">
        <div class="stat-card">
            <div class="bg pad-2 wd-100">
                <h4>
                    Occupied
                </h4>
                <p>
                    @occupiedKennels
                </p>
                <label>

                    kennel@(occupiedKennels > 1 ? "s" : "")@(occupiedKennels == 0 ? "s" : "") with active dogs
                </label>
            </div>
        </div>
    </div>
    <div class="rounded-xl px-5 py-4 flex flex-col gap-2 relative overflow-hidden">
        <div class="stat-card">
            <div class="bg pad-2 wd-100">
                <h4>
                    Available
                </h4>
                <p>
                    @availableKennels
                </p>
                <label>
                    kennel@(availableKennels > 1 ? "s" : "")@(availableKennels == 0 ? "s" : "") free today
                </label>
            </div>
        </div>
    </div>
    <div class="rounded-xl px-5 py-4 flex flex-col gap-2 relative overflow-hidden">
        <div class="stat-card">
            <div class="bg pad-2 wd-100">
                <h4>
                    Needs Cleaning
                </h4>
                <p>
                    @needCleanKennels
                </p>
                <label>
                    kennel@(needCleanKennels > 1 ? "s" : "")@(availableKennels == 0 ? "s" : "") need cleaning
                </label>
            </div>
        </div>
    </div>
 </div>
    <div class="row wd-100">
        <h4 class="page-minor-header ">
        Kennel Status — @startDate.ToShortDateString()
        </h4>
    </div>

<KennelList allKennels="allKennels" bookingDogKennels="bookingDogKennels" bookings="bookings" currentDogs="currentDogs" />
