@page "/createKennel"

@using BoardingKennelBookings.Components.Services
@using BoardingKennelBookings.Components.Models

@rendermode InteractiveServer
@inject KennelService KennelService

<EditForm Model="newKennel" OnValidSubmit="HandleSubmit" FormName="CreateKennelForm">
    <DataAnnotationsValidator />
    <div class="booking-form">

        <div class="booking-form-header">
            <p>Enter the kennel details below.</p>
        </div>

        <div class="booking-form-fields">
            <div class="booking-form-field">
                <label for="kennelNumber">Kennel number</label>
                <InputNumber id="kennelNumber" class="booking-form-input" @bind-Value="newKennel.KennelNumber" />
            </div>
        </div>

        <div class="booking-form-fields-validation">
            <div class="validation-message">
                <ValidationSummary />
            </div>
            @if (errorMessage != null)
            {
                <div class="validation-message">
                    @errorMessage
                </div>
            }
        </div>

        <div class="booking-form-actions final">
            <button type="submit" class="booking-form-button booking-form-button-primary">
                Create kennel
            </button>
        </div>

    </div>
</EditForm>


@code {
    private Kennel newKennel = new();
    private Kennel? createdKennel;
    private string? errorMessage;

    private async Task HandleSubmit()
    {
        try
        {
            createdKennel = await KennelService.CreateKennelAsync(newKennel);
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;

        }

    }
}
@if (createdKennel != null)
{
    <div class="booking-form-kennel-section">
        <div class="booking-form-kennel-header">
            <h3>Kennel created</h3>
            <p>Kennel number @createdKennel.KennelNumber has been added.</p>
        </div>
    </div>
}