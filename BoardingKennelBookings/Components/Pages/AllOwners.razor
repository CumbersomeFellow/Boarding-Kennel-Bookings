@page "/allowners"

@using BoardingKennelBookings.Components.Services
@using BoardingKennelBookings.Components.Models
@using BoardingKennelBookings.Components.Helpers

@rendermode InteractiveServer
@inject OwnerService OwnerService

@code {
    private List<Owner> Owners = new();
    private bool noResults = false;
    List<Owner> defaultList = new();

    protected override async Task OnInitializedAsync()
    {
        Owners = await OwnerService.GetAllOwnersAsync();
        Owners = Owners.OrderBy(owner => owner.FirstName).ToList();
        defaultList = Owners;
    }

    private string searchOwnerNameText = "";

    private List<Owner> SearchedOwners = new();

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        searchOwnerNameText = e.Value?.ToString() ?? "test";

        await SearchOwnersByName();
    }

    protected async Task SearchOwnersByName()
    {
        List<Owner> allResults = new();

        allResults = SearchHelper.Search<Owner>(searchOwnerNameText, defaultList, owner => { return owner.FirstName + " " + owner.LastName; });

        if (searchOwnerNameText.Length == 0)
        {
            Owners = defaultList;
            noResults = false;
        }
        else if (allResults.Count == 0)
        {
            noResults = true;
        }
        else
        {
            Owners = allResults.OrderBy(owner => owner.FirstName).ToList();
            noResults = false;
        }
    }
}

<div class="booking-history">

    <div class="booking-history-header">
        <div>
            <p>View all owners.</p>
        </div>
    </div>

    <div class="booking-history-filters is-compact">
        <section class="booking-history-field">
            <label for="owner-search">Search owners</label>
            <input id="owner-search"
                   class="booking-history-input"
                   placeholder="Search by name"
                   value="@searchOwnerNameText"
                   @oninput="HandleSearchInput" />
        </section>
    </div>

    <div class="bk-table-wrap">
        @if (Owners.Count == 0)
        {
            <div class="bk-table-empty">
                <p>Loading owners...</p>
            </div>
        }
        else if (noResults)
        {
            <div class="bk-table-empty">
                <p>No results found.</p>
            </div>
        }
        else
        {
            <table class="bk-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Contact number</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var owner in Owners)
                    {
                        <tr @key="owner.OwnerID">
                            <td class="bk-cell-dog">@owner.FirstName @owner.LastName</td>
                            <td class="bk-cell-owner">@owner.Email</td>
                            <td class="bk-cell-date">@owner.ContactNumber</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (Owners.Count > 0 && !noResults)
    {
        <div class="bk-table-toolbar">
            <span class="bk-table-count">@Owners.Count @(Owners.Count == 1 ? "record" : "records")</span>
        </div>
    }

</div>
