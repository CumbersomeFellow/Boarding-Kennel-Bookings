@page "/allkennels"

@using BoardingKennelBookings.Components.Services
@using BoardingKennelBookings.Components.Models
@using BoardingKennelBookings.Components.Helpers

@rendermode InteractiveServer
@inject KennelService KennelService
@inject DogService DogService
@inject BookingService BookingService

@code {
    private List<Kennel> Kennels = new();
    private List<Booking> Bookings = new();
    private DateTime startDate = DateTime.Parse("01/07/2024 00:00:00");
    private DateTime endDate = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        Kennels = await KennelService.GetAllKennels();
        Bookings = await BookingService.FindBookingsWithInDateRange(startDate, endDate);
    }
}
<!--Add Callender to see what dogs are booked in when-->

<div class="booking-history">

    <div class="booking-history-header">
        <div>
            <h3>Kennels</h3>
            <p>View all kennels and recent bookings.</p>
        </div>
    </div>

    <div class="previous-bookings">
        <div class="previous-bookings-header">
            <h3>All kennels</h3>
            @if (Kennels.Count > 0)
            {
                <span class="previous-bookings-count">
                    @Kennels.Count @(Kennels.Count == 1 ? "kennel" : "kennels")
                </span>
            }
        </div>

        <div class="previous-bookings-list">
            @if (Kennels.Count == 0)
            {
                <div class="booking-history-empty">
                    <p>Loading kennels...</p>
                </div>
            }
            else
            {
                @foreach (var kennel in Kennels)
                {
                    <article class="previous-bookings-card" @key="kennel.KennelID">
                        <div class="booking-history-details">
                            <div class="previous-bookings-owner">
                                <h4>Kennel @kennel.KennelID</h4>
                                <span class="previous-bookings-dog">@kennel.Status</span>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>
    </div>

    @if (Bookings.Count > 0)
    {
        <div class="previous-bookings">
            <div class="previous-bookings-header">
                <h3>Bookings</h3>
                <span class="previous-bookings-count">
                    @Bookings.Count @(Bookings.Count == 1 ? "booking" : "bookings")
                </span>
            </div>

            <div class="previous-bookings-list">
                @foreach (var singleBooking in Bookings)
                {
                    <article class="previous-bookings-card" @key="singleBooking.BookingID">
                        <div class="previous-bookings-dates">
                            <div class="previous-bookings-date">
                                <span class="previous-bookings-label">Check-in</span>
                                <span>@singleBooking.StartDate.ToString("dd MMM yyyy")</span>
                            </div>

                            <span class="previous-bookings-arrow">→</span>

                            <div class="previous-bookings-date">
                                <span class="previous-bookings-label">Check-out</span>
                                <span>@singleBooking.EndDate.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    }

</div>