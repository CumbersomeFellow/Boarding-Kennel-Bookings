@page "/allkennels"

@using BoardingKennelBookings.Components.Services
@using BoardingKennelBookings.Components.Models
@using BoardingKennelBookings.Components.Helpers

@rendermode InteractiveServer
@inject KennelService KennelService
@inject DogService DogService
@inject BookingService BookingService

@code {
    private List<Kennel> Kennels = new();
    private List<Booking> Bookings = new();
    private DateTime startDate = DateTime.Parse("01/07/2024 00:00:00");
    private DateTime endDate = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        Kennels = await KennelService.GetAllKennels();
        Bookings = await BookingService.FindBookingsWithInDateRange(startDate, endDate);
    }
}
<!--Add Callender to see what dogs are booked in when-->

<div class="booking-history">

    <div class="booking-history-header">
        <div>
            <p>View all kennels and recent bookings.</p>
        </div>
    </div>

    <div class="bk-table-wrap">
        @if (Kennels.Count == 0)
        {
            <div class="bk-table-empty">
                <p>Loading kennels...</p>
            </div>
        }
        else
        {
            <table class="bk-table">
                <thead>
                    <tr>
                        <th>Kennel</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kennel in Kennels)
                    {
                        <tr @key="kennel.KennelID">
                            <td class="bk-cell-kennel">K@(kennel.KennelID.ToString("00"))</td>
                            <td><span class="bk-badge">@kennel.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (Kennels.Count > 0)
    {
        <div class="bk-table-toolbar">
            <span class="bk-table-count">@Kennels.Count @(Kennels.Count == 1 ? "record" : "records")</span>
        </div>
    }

    @if (Bookings.Count > 0)
    {
        <div class="bk-table-wrap">
            <table class="bk-table">
                <thead>
                    <tr>
                        <th>Check-in</th>
                        <th>Check-out</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var singleBooking in Bookings)
                    {
                        <tr @key="singleBooking.BookingID">
                            <td class="bk-cell-date">@singleBooking.StartDate.ToString("dd/MM/yyyy")</td>
                            <td class="bk-cell-date">@singleBooking.EndDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="bk-table-toolbar">
            <span class="bk-table-count">@Bookings.Count @(Bookings.Count == 1 ? "booking" : "bookings")</span>
        </div>
    }

</div>
