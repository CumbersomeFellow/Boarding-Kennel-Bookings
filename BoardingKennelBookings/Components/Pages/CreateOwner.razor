@using BoardingKennelBookings.Components.Services
@using BoardingKennelBookings.Components.Models

@page "/CreateOwner"
@rendermode InteractiveServer
@inject OwnerService OwnerService

<EditForm Model="newOwner" OnValidSubmit="HandleSubmit" FormName="CreateOwnerForm">
    <div class="booking-form">

        <div class="booking-form-header">
            <h2>Create owner</h2>
            <p>Enter the owner's details below.</p>
        </div>

        <div class="booking-form-fields">
            <div class="booking-form-field">
                <label for="ownerFirstName">First name</label>
                <InputText id="ownerFirstName" class="booking-form-input" @bind-Value="newOwner.FirstName" />
            </div>

            <div class="booking-form-field">
                <label for="ownerLastName">Last name</label>
                <InputText id="ownerLastName" class="booking-form-input" @bind-Value="newOwner.LastName" />
            </div>
        </div>

        <div class="booking-form-fields">
            <div class="booking-form-field">
                <label for="ownerEmail">Email</label>
                <InputText id="ownerEmail" class="booking-form-input" @bind-Value="newOwner.Email" />
            </div>

            <div class="booking-form-field">
                <label for="ownerContactNumber">Contact number</label>
                <InputText id="ownerContactNumber" class="booking-form-input" @bind-Value="newOwner.ContactNumber" />
            </div>
        </div>

        <div class="booking-form-actions final">
            <button type="submit" class="booking-form-button booking-form-button-primary">
                Create owner
            </button>
        </div>

    </div>
</EditForm>

@code{
    private Owner newOwner = new();
    private Owner? createdOwner;

    private async Task HandleSubmit()
    {
        createdOwner = await OwnerService.CreateOwnerAsync(newOwner);
    }
}

@if (createdOwner != null)
{
    <div class="booking-form-kennel-section">
        <div class="booking-form-kennel-header">
            <h3>Owner created</h3>
            <p>@createdOwner.FirstName @createdOwner.LastName has been added.</p>
        </div>
        <p class="booking-form-kennel-empty">
            Email: @createdOwner.Email<br />
            Phone: @createdOwner.ContactNumber
        </p>
    </div>
}