@using BoardingKennelBookings.Components.Services
@using BoardingKennelBookings.Components.Models
@using BoardingKennelBookings.Components.Helpers

@rendermode InteractiveServer
@inject OwnerService OwnerService
@inject DogService DogService
@inject KennelAvailabilityService KennelAvailabilityService
@inject BookingService BookingService

@code {
    [Parameter]
    public List<Owner> Owners { get; set; } = new();
    [Parameter]
    public Booking? editedBooking { get; set; } = null;
    [Parameter]
    public bool isEditingBooking { get; set; } = false;
    private List<Dog> OwnerDogs = new();
    private Guid selectedOwnerId;
    private Owner selectedOwner  = new();
    private List<Booking> selectedOwnerBookings  = new();
    private List<BookingDogKennel> selectedOwnerBDKs = new();
    private List<Kennel> availableKennels = new List<Kennel>();
    private DateTime selectedStartDate = DateTime.Today;
    private DateTime selectedEndDate = DateTime.Today.AddDays(1);
    private bool validDate = true;
    private bool amPickUp = true;
    private bool amDropOff = true;
    private string? prevDateError;
    private string? invalidDateError;
    private bool newSelectedDate = false;
    private string? dogBookingError;
    private Booking? completedNewBooking;
    private BookingForm newBooking = new();
    private List<Booking> prevOwnerBookings = new();

    protected override async Task OnInitializedAsync()
    {
        if (isEditingBooking && editedBooking != null)
        {
            selectedOwner = editedBooking.Owner; 
            selectedOwnerId = editedBooking.OwnerID;
            amPickUp = editedBooking.AMPickup;
            amDropOff = editedBooking.AMDropoff;
            selectedStartDate = editedBooking.StartDate;
            selectedEndDate = editedBooking.EndDate;

            newBooking.OwnerID = editedBooking.OwnerID;
            newBooking.StartDate = editedBooking.StartDate;
            newBooking.EndDate = editedBooking.EndDate;
            newBooking.AMDropoff = editedBooking.AMDropoff;
            newBooking.AMPickup = editedBooking.AMPickup;

            OwnerDogs = await DogService.GetOwnerDogsAsync(editedBooking.OwnerID);
        }
        else
        {
            newBooking.StartDate = selectedStartDate;
            newBooking.EndDate = selectedEndDate;
        }
    }

    private async Task HandleOwnerChange()
    {
        OwnerDogs = await DogService.GetOwnerDogsAsync(selectedOwnerId);
        newBooking.OwnerID = selectedOwnerId;
        selectedOwnerBDKs = new();
        selectedOwnerBookings = new();
        availableKennels = new();
    }

    private bool IsKennelDisabled(Guid dogID, int kennelID)
    {
        if (!newBooking.DogKennelAssignments.TryGetValue(dogID, out var assignedKennel))
        {
            return false;
        }

        return assignedKennel != kennelID;
    }

    private void HandleDogKennelAssignment(Guid dogID, int kennelID, ChangeEventArgs eventArgs)
    {
        bool value = (bool)eventArgs.Value;

        if (!value)
        {
            newBooking.DogKennelAssignments.Remove(dogID);
            if (!newBooking.DogKennelAssignments.ContainsKey(dogID))
            {
                dogBookingError = "";
            }
        }
        else
        {
            if (newBooking.DogKennelAssignments.ContainsKey(dogID))
            {
                dogBookingError = $"{OwnerDogs.First(dog => dog.ID == dogID).DogName} is in multiple kennels, please select one kennel for them.";
            }
            else
            {
                newBooking.DogKennelAssignments[dogID] = kennelID;
            }
        }
    }

    private void HandleDateChosen()
    {
        DateTime todaysDate = DateTime.Today;
        bool isValidDate = DateHelper.IsValidDateRange(selectedStartDate, selectedEndDate);

        newSelectedDate = true;

        if ((selectedStartDate < todaysDate || selectedEndDate < todaysDate) && !isEditingBooking) 
        { 
            prevDateError = "Please choose a future date.";
        }
        else
        {
            prevDateError = null;
        }

        if (isValidDate)
        {
            invalidDateError = null;
        }
        else
        {
            invalidDateError = "End date is earlier than start date.";
        }
    }

    private async Task HandleCheckKennelAvailable()
    {
        validDate = DateHelper.IsValidDateRange(selectedStartDate, selectedEndDate);

        if (validDate)
        {
            newSelectedDate = false;
            newBooking.StartDate = selectedStartDate;
            newBooking.EndDate = selectedEndDate;
            selectedOwnerBookings = await BookingService.FindBookingsWithDateOwnerID(selectedStartDate, selectedEndDate, selectedOwnerId);
            selectedOwnerBDKs = new();

            if (selectedOwnerBookings.Count > 0)
            {
                foreach (var booking in selectedOwnerBookings)
                {
                    selectedOwnerBDKs.AddRange(await BookingService.FindBookingDogKennelsWithBookingID(booking.BookingID));
                }
            }
            if (isEditingBooking)
            {
                availableKennels = await KennelAvailabilityService.GetAllKennelsAvailable(selectedStartDate, selectedEndDate, editedBooking.BookingID);
            }
            else
            {
                availableKennels = await KennelAvailabilityService.GetAllKennelsAvailable(selectedStartDate, selectedEndDate);

            }
        }
    }
    private async Task HandleSubmit()
    {

        Booking booking = new Booking
        {
            BookingID = isEditingBooking ? editedBooking.BookingID : Guid.NewGuid(),
            OwnerID = newBooking.OwnerID.Value,
            StartDate = newBooking.StartDate,
            EndDate = newBooking.EndDate,
            AMDropoff = amDropOff,
            AMPickup = amPickUp
        };

        if (isEditingBooking)
        {
            //bit long winded - could do most of this in the service. Leave for now.
            List<BookingDogKennel> selectedBDKs = await BookingService.FindBookingDogKennelsWithBookingID(editedBooking.BookingID);

            foreach (var bdk in selectedBDKs)
            {
                await BookingService.DeleteBookingDogKennels(bdk.BookingDogKennelID);
            }

            await BookingService.EditBooking(booking);

            completedNewBooking = booking;
        }
        else
        {
            completedNewBooking = await BookingService.CreateBookingAsync(booking);
        }

        foreach (var (dogID, kennelID) in newBooking.DogKennelAssignments)
        {
            BookingDogKennel bookingDogKennel = new BookingDogKennel
            {
                BookingDogKennelID = Guid.NewGuid(),
                BookingID = booking.BookingID,
                DogID = dogID,
                KennelID = kennelID
            };

            await BookingService.CreateBookingDogKennel(bookingDogKennel);
        }
    }
}

<div class="booking-form">

    <div class="booking-form-header">
        <h2>@(isEditingBooking ? "Edit booking" : "Create booking")</h2>
        <p>Enter the booking details below.</p>
    </div>

    <div class="booking-form-fields">

        <div class="booking-form-field">
          
                @if (Owners.Count == 0)
                {
                    <p>Loading Owners...</p>
                }
                else if (Owners.Count == 1)
                {
                <p>Owner: @Owners.FirstOrDefault().FirstName @Owners.FirstOrDefault().LastName</p>
                }
                else
                {   

                <label for="owner">Owner</label>
                    <InputSelect class="booking-form-input" @bind-Value="selectedOwnerId" @bind-Value:after="HandleOwnerChange">

                        <option value="">--Choose an owner--</option>
                        @foreach (var owner in Owners)
                        {
                            <option value="@owner.OwnerID">@owner.FirstName @owner.LastName</option>
                        }
                    </InputSelect>
                }
            
            @* <ValidationMessage For="@(() => newBooking.OwnerID)" /> *@
        </div>

    </div>
    <div class="booking-form-fields">
        <div class="booking-form-field">
            <label for="startDate">Start date</label>
            <InputDate id="startDate" class="booking-form-input" @bind-Value="selectedStartDate" @bind-Value:after="HandleDateChosen" />
        </div>

        <div class="booking-form-field">
            <label for="endDate">End date</label>
            <InputDate id="endDate" class="booking-form-input" @bind-Value="selectedEndDate" @bind-Value:after="HandleDateChosen" />
        </div>
    </div>
    <div class="booking-form-actions">
        <button type="submit" class="booking-form-button booking-form-button-primary" @onclick="HandleCheckKennelAvailable">
            Check Dates
        </button>
    </div>
    <div class="booking-form-fields">
        <section class="booking-form-field">
            <label>AM or PM drop off?</label>

            <InputRadioGroup @bind-Value="amDropOff" class="booking-form-radio-group">
                <label class="booking-form-radio-option ">
                    <InputRadio Value="true" />
                    AM
                </label>

                <label class="booking-form-radio-option ">
                    <InputRadio Value="false" />
                    PM
                </label>
            </InputRadioGroup>
        </section>

        <section class="booking-form-field">
            <label>AM or PM pick up?</label>

            <InputRadioGroup @bind-Value="amPickUp" class="booking-form-radio-group">
                <label class="booking-form--radio-option">
                    <InputRadio Value="true" />
                    AM
                </label>

                <label class="booking-form--radio-option">
                    <InputRadio Value="false" />
                    PM
                </label>
            </InputRadioGroup>
        </section>
    </div>
    <div class="booking-form-kennels">
        <h3>Available kennels</h3>
        <p>Select the kennels required for this booking.</p>

        <div class="booking-form__dog-assignments">
            @if (availableKennels.Count > 0 && validDate)
            {
                <div class="booking-form-kennels">
                    @foreach (var kennel in availableKennels)
                    {
                        <section class="booking-form-kennel" @key="kennel.KennelID">
                            <h4>Kennel @kennel.KennelID</h4>

                            @if (selectedOwnerId != Guid.Empty)
                            {
                                <div class="booking-form-dog-list">
                                    @foreach (var dog in OwnerDogs)
                                    {
                                        <label class="booking-form-dog-option" @key="dog.ID">

                                            <input type="checkbox" checked="@IsKennelDisabled(dog.ID, kennel.KennelID)" disabled="@IsKennelDisabled(dog.ID, kennel.KennelID)" @onchange="e => HandleDogKennelAssignment(dog.ID, kennel.KennelID, e)" />

                                            @dog.DogName
                                        </label>
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>
            }
        </div>
    </div>

    <div class="booking-form-actions final">
        <button type="button"
                class="booking-form-button booking-form-button-secondary">
            Cancel
        </button>

        <button type="submit"
                class="booking-form-button booking-form-button-primary">
            @(isEditingBooking ? "Update booking" : "Save booking")
        </button>
    </div>

</div>

@if (completedNewBooking == null)
{
    <EditForm Model="newBooking" FormName="BookingForm" OnValidSubmit="HandleSubmit">

        @if (selectedOwnerBookings.Count > 0)
        {
            <div class="flex">
                <section>
                    <label>
                        Previous Bookings
                    </label>

                </section>
                <section>
           
                    @foreach (var curBDK in selectedOwnerBDKs)
                    {
                        var curBooking = selectedOwnerBookings.FirstOrDefault(booking => booking.BookingID == curBDK.BookingID);
                        var curDog = OwnerDogs.FirstOrDefault(dog => dog.ID == curBDK.DogID);


                        <p>
                            @curDog.DogName is booked in kennel @curBDK.KennelID for @curBooking.StartDate.ToShortDateString() to @curBooking.EndDate.ToShortDateString()
                        </p>
                    }
                    
                  
                </section>
            </div>
        }

        @if (availableKennels.Count > 0 && validDate)
        {
            foreach (var kennel in availableKennels)
            {
                <section>
                    <label>
                        Kennel @kennel.KennelID
                    </label>
                    @if (selectedOwnerId != Guid.Empty)
                    {
                        @foreach (var dog in OwnerDogs)
                        {
                            <label>
                                <input name="" disabled="@IsKennelDisabled(dog.ID, kennel.KennelID)" type="checkbox" @onchange="e => HandleDogKennelAssignment(dog.ID, kennel.KennelID, e)" />
                                @dog.DogName
                            </label>
                        }
                    }
                </section>
            }
        }
        <section>
            <label>
                AM or PM drop off?
            </label>
            <InputRadioGroup @bind-Value="amDropOff">
                <label>
                    <InputRadio Value="true" />
                    AM
                </label>

                <label>
                    <InputRadio Value="false" />
                    PM
                </label>
            </InputRadioGroup>
        </section>
        <section>
            <InputRadioGroup @bind-Value="amPickUp">
                <label>
                    AM or PM pick up?
                </label>
                <label>
                    <InputRadio Value="true" />
                    AM
                </label>

                <label>
                    <InputRadio Value="false" />
                    PM
                </label>
            </InputRadioGroup>
        </section>
        <section>
            <DataAnnotationsValidator />
            <ValidationSummary />
            @if (dogBookingError != null)
            {
                <div class="validation-message">
                    @dogBookingError
                </div>
            }
            @if (prevDateError != null)
            {
                <div class="validation-message">
                    @prevDateError
                </div>
            }
            @if (invalidDateError != null)
            {
                <div class="validation-message">
                    @invalidDateError
                </div>
            }
            @if (newSelectedDate)
            {
                <div class="validation-message">
                    <span>Please hit check again</span>
                </div>
            }
        </section>
        @if (newBooking.DogKennelAssignments.Count > 0 && invalidDateError == null && prevDateError == null && newSelectedDate == false)
        {
            <section>
                <button type="submit" class="btn btn-blue">
                    Submit
                </button>
            </section>
        }
    </EditForm>
}
@if (completedNewBooking != null)
{
    <section>
        Completed booking for @completedNewBooking.StartDate.ToShortDateString() to @completedNewBooking.EndDate.ToShortDateString()
    </section>
}